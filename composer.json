{
    "name": "samnoble118/game-tracker",
    "description": "Track a game collection, platforms, play status, and progress.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GameTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GameTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
